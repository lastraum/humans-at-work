{
  "name": "humans-at-work",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "HAW_PROD=1 vite --host 127.0.0.1 --port 5885 --strictPort",
    "start:preview": "vite preview --host 127.0.0.1 --port 5885 --strictPort",
    "build:prod": "bash scripts/deploy-prod.sh",
    "generate:floor": "node scripts/generate-floor-plate.mjs",
    "test:floors": "npx tsx scripts/test-floors.mjs",
    "test:xp": "npx tsx scripts/test-xp.mjs",
    "test:link": "npx tsx scripts/test-link.mjs",
    "test:gate": "npx tsx scripts/test-gate.mjs",
    "test:reservations": "npx tsx scripts/test-reservations.mjs",
    "test:auth": "npx tsx scripts/test-supabase-auth.mjs",
    "fill:floor": "node scripts/test-fill-floor.mjs",
    "fill:couch": "node scripts/test-fill-floor.mjs --couch",
    "teaser": "node scripts/teaser-floor.mjs",
    "vendor:assets": "./scripts/vendor-claw3d-assets.sh"
  },
  "dependencies": {
    "@dcl/crypto": "^3.6.0",
    "@supabase/supabase-js": "^2.117.2",
    "decentraland-crypto-fetch": "^2.0.1",
    "jose": "^6.2.12",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.0",
    "three": "^0.170.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
