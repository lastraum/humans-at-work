# Google sign-in. The client id is public. Either name is read.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Email codes via Resend. Without a key, a code is returned only to a
# direct localhost client. Public requests get "email sign-in unavailable".
RESEND_API_KEY=
AUTH_FROM=

# Comma-separated account emails that may use film tools (?film, ?shot, ?follow).
# Empty disables them. The server checks the signed-in session; the list is not public.
ADMIN_EMAILS=

# Stats page, served at /<STATS_AUTH> when this is 16–128 url-safe characters.
# Leave empty to disable it.
STATS_AUTH=

# Optional local LiveKit. The floor's voice and chat use the Decentraland
# world nflnetwork.dcl.eth. Nothing in the client calls /__livekit/token.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
