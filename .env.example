# Supabase Auth. Sign-in is OAuth only: Google, X, Discord, and Slack (slack_oidc).
# Email codes are off. Do not set a Resend key.
# This project is shared with another app. Add redirect URLs; do not change its site URL.
# The publishable key is safe in the client. Never commit the secret key.
SUPABASE_URL=https://tddtdrdhtgsbjqgmqjwe.supabase.co
SUPABASE_SECRET_KEY=
VITE_SUPABASE_URL=https://tddtdrdhtgsbjqgmqjwe.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Buttons to show. Unset shows Google, X, Discord, and Slack.
# Example for a partial launch: google,slack_oidc
VITE_AUTH_PROVIDERS=

# Comma-separated account emails that may use film tools (?film, ?shot, ?follow).
# Empty disables them unless ADMIN_SUPABASE_IDS matches. The server checks the
# signed-in session; the list is not public.
ADMIN_EMAILS=

# Supabase user ids (the JWT sub) for admins with no email, such as X accounts.
ADMIN_SUPABASE_IDS=

# Stats page, served at /<STATS_AUTH> when this is 16–128 url-safe characters.
# Leave empty to disable it.
STATS_AUTH=

# Optional local LiveKit. The floor's voice and chat use the Decentraland
# world nflnetwork.dcl.eth. Nothing in the client calls /__livekit/token.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
